<div class="mybox">
  <div class="container">
  <h1>Already available movie lists</h1>
  <div class="parent">
    <div class="actionlist">
      <% @lists.each do |list| %>
        <div class="moviecard" style="width: 18rem;">
          <div class="card-body">
            <h3 class="card-title"><%= link_to list.name, list_path(list) %></h3>
            <h4 class="card-subtitle mb-2 text-body-secondary"><%= "Number of movies: #{list.movies.length}" %></h4>
          </div>
        </div>
      <% end %>
    </div>
    <div class="bottomsection">
      <h2>Create your own list</h2>
      <%= simple_form_for @list do |f| %>
        <%= f.input :name %>
        <%= f.submit %>
      <% end %>
    </div>
  </div>
  </div>
</div>

<div class="container text-center">
  <div class="row">
    <div class="col-sm-8"><strong>Already available movie lists</strong></div>
      <ul class="list-group list-group-horizontal-sm">
        <% @lists.each do |list| %>
        <li class="list-group-item">
          <div class="card listcard">
            <div class="card-body">
              <%= link_to list.name, list_path(list) %>
              <span class="badge text-bg-primary rounded-pill"><%= list.movies.length %></span>
            </div>
          </div>
        </li>
        <% end %>
      </ul>
    <div class="col-sm-4"><strong>Create your own list</strong>
      <%= simple_form_for @list do |f| %>
        <%= f.input :name %>
        <%= f.submit %>
      <% end %>
    </div>
  </div>
</div>
