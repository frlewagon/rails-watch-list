<div class="mybox">
  <div class="container">
    <h1>Already available movie lists</h1>
    <div class="parent">
      <div class="actionlist">
        <% @lists.each do |list| %>
          <div class="moviecard" style="width: 18rem;">
            <div class="card-body">
              <h3 class="card-title"><%= link_to list.name, list_path(list) %></h3>
              <h4 class="card-subtitle mb-2 text-body-secondary"><%= "Number of movies: #{list.movies.length}" %></h4>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<div class="mybox">
  <div class="container text-center">
    <div class="row">
      <div class="col-sm-8"><strong>Already available lists</strong></div>
      <div class="col-sm-4 border-start"><strong>Create your own list</strong>
        <%= simple_form_for @list do |f| %>
          <%= f.input :name %>
          <%= f.submit %>
        <% end %>
      </div>
    </div>
  </div>
</div>
