<h1><%= "List: #{@list.name}" %></h1>
<h2><%= "Movies included in this  list:" %></h2>
<ul>
<% @movies.each do |movie| %>
<% bookmark = Bookmark.find_by(movie_id: movie.id, list_id: @list.id) %>
<li> <%= movie.title %> <%= link_to "Remove this movie", bookmark_path(bookmark.id) , class: "btn btn-outline-warning mt-3", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %> </li>
<% end %>
</ul>

<h2><%= "Add a new movie in this list" %></h2>

<%= simple_form_for [@list, @bookmark] do |f| %>
  <%= f.association :movie %>
  <%= f.input :comment %>
  <%= f.submit %>
<% end %>

<h2><%= "Reviews for this  list:" %></h2>
<ul>
  <% @reviews.each do |review| %>
    <li> <%= review.stars %> </li>
    <li> <%= review.content %> </li>
    <li><%= link_to "Remove this review", review_path(review.id) , class: "btn btn-outline-warning mt-3", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %> </li>
  <% end %>
</ul>

<h2><%= "Add a review for this  list:" %></h2>
<%= simple_form_for([ @list, @review ]) do |f| %>
  <%= f.input :stars %>
  <%= f.input :content %>
  <%= f.submit %>
<% end %>

<%= link_to "Back to list menu", lists_path, class: "btn btn-outline-primary mt-3" %>
