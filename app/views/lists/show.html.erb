<h1><%= "Details for list: #{@list.name}" %></h1>

<ul>
<% @movies.each do |movie| %>
<% bookmark = Bookmark.find_by(movie_id: movie.id, list_id: @list.id) %>
<li> <%= movie.title %> <%= link_to "Remove this movie", bookmark_path(bookmark.id) , class: "btn btn-outline-warning mt-3", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %> </li>
<% end %>
</ul>

<%= link_to "Add a movie to this list", new_list_bookmark_path(@list), class: "btn btn-outline-success mt-3" %>
<%= link_to "Back to list menu", lists_path, class: "btn btn-outline-primary mt-3" %>
